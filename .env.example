# Application settings. pydantic-settings reads these with the VNOPT_ prefix.
VNOPT_ENVIRONMENT=development
VNOPT_LOG_LEVEL=INFO
VNOPT_API_HOST=127.0.0.1
VNOPT_API_PORT=8000

# Base URL the Next.js dev server proxies /api/* to.
API_URL=http://localhost:8000

# Data layer ----------------------------------------------------------------
# SQLAlchemy URL: SQLite for local dev, Postgres in production.
DATABASE_URL=sqlite:///./vnopt.db
# Failover order of anonymous providers; KBS is primary (history + reference data).
PROVIDER_ORDER=kbs,vci,dnse,tcbs,ssi_iboard
# Shared secret for POST/GET /api/v1/data/refresh and GET /api/v1/data/probe.
# For Vercel Cron, also set CRON_SECRET to the same value.
REFRESH_TOKEN=change-me
# Optional tuning (defaults shown).
# VNOPT_PROVIDER_RATE_LIMIT_PER_MINUTE=20
# VNOPT_PRICE_MISMATCH_TOLERANCE=0.005
# VNOPT_SYNC_BATCH_SIZE=50
# VNOPT_SYNC_TIME_BUDGET_SECONDS=45
# VNOPT_ON_DEMAND_HISTORY_DAYS=365
# Efficient frontier: random-portfolio hard cap and wall-clock budget.
# VNOPT_FRONTIER_MAX_PORTFOLIOS=20000
# VNOPT_FRONTIER_TIME_BUDGET=30

# V2 precompute pipeline (packages/data/data/v2) ----------------------------------
# Failover chains per data type (defaults verified from recorded fixtures; only
# enable a provider after the cloud-IP probe passes on the GitHub runner).
# VNOPT_V2_OHLCV_ORDER=ssi_statistics,vci,kbs
# VNOPT_V2_CONSTITUENTS_ORDER=kbs
# VNOPT_V2_SECTOR_MAP_ORDER=ssi_statistics
# VNOPT_V2_RATIOS_ORDER=ssi_statistics
# VNOPT_V2_COMPANY_PROFILE_ORDER=ssi_statistics
# VNOPT_V2_CORPORATE_ACTIONS_ORDER=ssi_statistics
# VNOPT_V2_SYMBOL_MASTER_ORDER=ssi_statistics,kbs
# Backfill start date (YYYY-MM-DD) and rolling-liquidity window (sessions).
# VNOPT_V2_BACKFILL_START_DATE=2023-01-01
# VNOPT_V2_PRECOMPUTE_WINDOW_SESSIONS=20
# Per-data-type request budgets (requests/minute) for the V2 adapters.
# VNOPT_V2_OHLCV_RATE_LIMIT_PER_MINUTE=20
# VNOPT_V2_RATIOS_RATE_LIMIT_PER_MINUTE=10
